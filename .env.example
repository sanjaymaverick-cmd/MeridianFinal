# Meridian Final — local. Copy to .env

# Leave unset to use embedded PGLite (no Postgres install).
# DATABASE_URL=postgres://user:pass@localhost:5432/meridian

# Persist the embedded DB across restarts (recommended on your PC).
PGLITE_DATA_DIR=./data/pglite

# Better Auth. Any long random string is fine for local paper.
BETTER_AUTH_SECRET=meridian-local-dev-secret-change-me-32
BETTER_AUTH_URL=http://localhost:3000

# Optional: Grok research (falls back to heuristic if unset)
# XAI_API_KEY=

# Optional later — never commit live keys
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
